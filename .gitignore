# ==========================================
# Unity Standard Exclusions
# ==========================================
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/
/[Cc]rash[Rr]eports/

# Never ignore asset .meta files
!/[Aa]ssets/**/*.meta

# Autogenerated JetBrains / IDE files
/[Aa]ssets/Plugins/Editor/JetBrains*
.vs/
.idea/
.vscode/
.consulo/
ExportedObj/
.gradle/

# Autogenerated Solution / Project files
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta
sysinfo.txt

# Local Backups and Batch Logs
/[Bb]ackups/
*.log

# Antigravity / Agent runtime cache
.gemini/

# OS Generated
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini

# Web Companion / Node Exclusions
node_modules/
dist/
.vite/
*.local
.env
.env.*
